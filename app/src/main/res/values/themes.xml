<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.June" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FAF9F6</item>
        <item name="android:colorBackground">#FAF9F6</item>
        <item name="colorPrimary">#FAF9F6</item>
    </style>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FAF9F6</item>
        <item name="android:colorBackground">#FAF9F6</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.June</item>
    </style>
</resources>